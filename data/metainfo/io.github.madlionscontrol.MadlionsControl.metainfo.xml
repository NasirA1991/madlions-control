<component type="desktop-application">
  <id>io.github.madlionscontrol.MadlionsControl</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Madlions Control</name>
  <summary>Configure MADLIONS magnetic-switch keyboards natively</summary>
  <developer id="io.github.nasira1991">
    <name>Nasir A.</name>
  </developer>
  <description>
    <p>
      Madlions Control is a native GTK4/libadwaita configuration tool for
      MADLIONS Hall-effect keyboards. It talks to the keyboard directly over
      its HID interface, so there is no browser tab, no vendor service and no
      account.
    </p>
    <p>Features:</p>
    <ul>
      <li>Per-key actuation point and rapid-trigger sensitivity</li>
      <li>Live analogue travel test with per-key heat map</li>
      <li>Lighting effects, brightness, speed and per-key colours</li>
      <li>Four-layer keymap editor and macro support</li>
      <li>Advanced keys, SOCD, OKS, rapid snappy and DKS</li>
      <li>Named profiles, presets, backups and a CLI for scripts</li>
    </ul>
    <p>
      Settings are only persisted to the keyboard when you explicitly save.
      Nothing is uploaded or collected.
    </p>
  </description>
  <launchable type="desktop-id">io.github.madlionscontrol.MadlionsControl.desktop</launchable>
